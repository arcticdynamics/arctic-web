# Vercel > Project > Settings > Environment Variables'a girilir. Gercek degerler repoya GIRMEZ.

# Neon entegrasyonu eklenince Vercel bunu otomatik tanimlar.
DATABASE_URL=postgres://kullanici:sifre@host/db

# IP hash tuzu, en az 16 karakter, rastgele (ornek: openssl rand -hex 24)
SALT=degistir-en-az-16-karakter-rastgele

# /api/export icin yonetici anahtari, en az 32 karakter (ornek: openssl rand -hex 32)
ADMIN_TOKEN=degistir-en-az-32-karakterlik-rastgele-anahtar

# Opsiyonel: kayitlari Google Sheets'e de dusurur (Apps Script web uygulamasi URL'si, .../exec)
GOOGLE_SHEET_URL=https://script.google.com/macros/s/XXXX/exec

# Opsiyonel: gunluk toplam kayit tavani (varsayilan 500)
DAILY_SIGNUP_CAP=500
